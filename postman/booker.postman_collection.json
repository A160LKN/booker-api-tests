{
  "info": {
    "_postman_id": "eb952265-94ee-46d6-a3d9-9b8928a040d1",
    "name": "Restful Booker — API tests",
    "description": "Те же сценарии, что и в pytest: доступность, авторизация, CRUD бронирования, доступ без токена.\n\nЗапросы связаны переменными: токен из «Авторизация» и id из «Создать бронирование» используются дальше, поэтому запускайте папки по порядку (Run collection) или через Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://restful-booker.herokuapp.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookingid",
      "value": ""
    },
    {
      "key": "firstname",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Общая проверка для всех запросов",
          "pm.test('Ответ быстрее 5 секунд', () => pm.expect(pm.response.responseTime).to.be.below(5000));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Доступность и авторизация",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ping"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 201 — так задумано в API', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Авторизация: неверный пароль",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong_password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Особенность API: ошибка приходит со статусом 200, поэтому проверяем тело",
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Причина — Bad credentials', () => pm.expect(pm.response.json().reason).to.eql('Bad credentials'));",
                  "pm.test('Токен не выдан', () => pm.expect(pm.response.json()).to.not.have.property('token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Авторизация: получить токен",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "const { token } = pm.response.json();",
                  "pm.test('Токен — непустая строка', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('token', token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Бронирование: полный цикл",
      "item": [
        {
          "name": "Создать бронирование",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"Tester\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2027-01-10\",\n    \"checkout\": \"2027-01-15\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Уникальное имя: API общий для всех, так находим именно своё бронирование",
                  "pm.collectionVariables.set('firstname', 'Aibol-' + Math.random().toString(16).slice(2, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const schema = {",
                  "  type: 'object', required: ['bookingid', 'booking'], additionalProperties: false,",
                  "  properties: {",
                  "    bookingid: { type: 'integer' },",
                  "    booking: {",
                  "      type: 'object', additionalProperties: false,",
                  "      required: ['firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates'],",
                  "      properties: {",
                  "        firstname: { type: 'string' }, lastname: { type: 'string' },",
                  "        totalprice: { type: 'integer' }, depositpaid: { type: 'boolean' },",
                  "        bookingdates: { type: 'object', required: ['checkin', 'checkout'], properties: {",
                  "          checkin: { type: 'string', pattern: '^\\\\d{4}-\\\\d{2}-\\\\d{2}$' },",
                  "          checkout: { type: 'string', pattern: '^\\\\d{4}-\\\\d{2}-\\\\d{2}$' } } },",
                  "        additionalneeds: { type: 'string' }",
                  "      }",
                  "    }",
                  "  }",
                  "};",
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Ответ соответствует схеме', () => pm.response.to.have.jsonSchema(schema));",
                  "const body = pm.response.json();",
                  "pm.test('Сохранены переданные данные', () => {",
                  "  pm.expect(body.booking).to.eql(JSON.parse(pm.variables.replaceIn(pm.request.body.raw)));",
                  "});",
                  "pm.collectionVariables.set('bookingid', body.bookingid);"
                ]
              }
            }
          ]
        },
        {
          "name": "Получить бронирование по id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Имя и цена совпадают с созданными', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.firstname).to.eql(pm.collectionVariables.get('firstname'));",
                  "  pm.expect(b.totalprice).to.eql(150);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Найти по имени и фамилии",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking?firstname={{firstname}}&lastname=Tester",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "firstname",
                  "value": "{{firstname}}"
                },
                {
                  "key": "lastname",
                  "value": "Tester"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('В списке есть созданное бронирование', () => {",
                  "  const ids = pm.response.json().map((x) => x.bookingid);",
                  "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('bookingid')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT: полностью обновить",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"Tester\",\n  \"totalprice\": 300,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2027-01-10\",\n    \"checkout\": \"2027-01-15\"\n  },\n  \"additionalneeds\": \"Late checkout\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Данные заменены', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.totalprice).to.eql(300);",
                  "  pm.expect(b.depositpaid).to.eql(false);",
                  "  pm.expect(b.additionalneeds).to.eql('Late checkout');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH: изменить только цену",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalprice\": 999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Цена изменилась, остальное — нет', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.totalprice).to.eql(999);",
                  "  pm.expect(b.additionalneeds).to.eql('Late checkout');",
                  "  pm.expect(b.firstname).to.eql(pm.collectionVariables.get('firstname'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Безопасность",
      "item": [
        {
          "name": "PUT без токена",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"Tester\",\n  \"totalprice\": 1,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2027-01-10\",\n    \"checkout\": \"2027-01-15\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE с поддельным токеном",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token=fake-token"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Данные не изменились",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Бронирование на месте, цена прежняя', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().totalprice).to.eql(999);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Удаление",
      "item": [
        {
          "name": "Удалить бронирование",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Особенность API: успешное удаление возвращает 201, а не 200 или 204",
                  "pm.test('Статус 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Удалённое не находится",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}